{
  "name": "pathwise",
  "version": "0.2.22",
  "private": true,
  "description": "Pathwise: a leveling and profession companion for World of Warcraft: Forever",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/curseforge.test.js tests/recipebook.test.js && lua5.1 tests/run.lua && lua5.1 tests/ui/run.lua && lua5.1 tests/heal/run.lua && lua5.1 tests/encounters/run.lua && lua5.1 tests/loot/run.lua",
    "media": "node tools/media.js",
    "recipes": "node tools/data/recipes.js",
    "data": "lua5.1 tools/data/build.lua",
    "routes": "lua5.1 tools/port/polestar.lua ../pathwise/addon/Pathwise_Guides/Guides.lua Pathwise/Routes",
    "link": "node tools/link.js",
    "pack": "node tools/pack.js",
    "curseforge": "node tools/curseforge.js",
    "set-version": "node tools/version.js",
    "test:ui": "lua5.1 tests/ui/run.lua",
    "media:ui": "node tools/media-ui.js",
    "test:heal": "lua5.1 tests/heal/run.lua",
    "kit": "node tools/kit.js",
    "test:encounters": "lua5.1 tests/encounters/run.lua",
    "test:loot": "lua5.1 tests/loot/run.lua",
    "loot": "node tools/data/loot.js",
    "recipebook": "node tools/data/recipebook.js"
  }
}
